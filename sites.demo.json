{
  "gitlab": { "url": "http://127.0.0.1:9999", "project": "acme/app", "branch": "main" },
  "oauth_client_id": "resonate-demo",
  "oauth_secret": "demo-secret",
  "environment_template": "{site}-{service}{postfix}",
  "pipeline_inputs": { "SITE": "{site}", "SERVICE": "{service}", "POSTFIX": "{postfix}", "DEPLOY_SHA": "{sha}" },
  "trigger_as": "inputs",
  "sites": [
    { "name": "bandung",  "version_url": "http://127.0.0.1:9999/sites/{site}/{service}{postfix}/version" },
    { "name": "jakarta",  "version_url": "http://127.0.0.1:9999/sites/{site}/{service}{postfix}/version" },
    { "name": "makassar", "version_url": "http://127.0.0.1:9999/sites/{site}/{service}{postfix}/version" },
    { "name": "medan",    "version_url": "http://127.0.0.1:9999/sites/{site}/{service}{postfix}/version" },
    { "name": "surabaya", "version_url": "http://127.0.0.1:9999/sites/{site}/{service}{postfix}/version" }
  ],
  "services": [
    { "name": "api-core",      "kind": "api" },
    { "name": "api-core",      "kind": "api", "postfix": "-partner", "sites": ["jakarta", "surabaya"] },
    { "name": "api-report",    "kind": "api" },
    { "name": "worker-mailer", "kind": "worker" },
    { "name": "worker-sync",   "kind": "worker" },
    { "name": "job-backfill",  "kind": "job" }
  ]
}
